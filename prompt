        function formatVariable(v) {
            let valueDisplay = '';

            // if value have basic type (e.g., int, string, bool)
            if (v.value && v.value !== '') {
                valueDisplay = escapeHtml(v.value);
            } 
            // Handle slices (type starts with "[]")
            else if (v.type && v.type.startsWith('[]')) {
                const len = v.len || 0;
                const cap = v.cap || 0;
                if (v.children && v.children.length) {
                    const elements = v.children.map(c => escapeHtml(c.value)).join(', ');
                    valueDisplay = `(len=${len} cap=${cap}) [${elements}]`;
                } else {
                    valueDisplay = `(len=${len} cap=${cap}) []`;
                }
            } 
            // Handle other complex types (structs, maps, etc.)
            else if (v.children && v.children.length) {
                valueDisplay = '{ ... }'; // placeholder for expandable tree
            } 
            else {
                valueDisplay = '?';
            }

            return `
                <div class="var-item">
                    <span class="var-name">${escapeHtml(v.name)}</span>:
                    <span class="var-value">${valueDisplay}</span>
                    <span class="var-type">${escapeHtml(v.type)}</span>
                </div>
            `;
        }

// Render a variable and its children recursively
function renderVariable(v, depth = 0) {
    const maxDepth = 3; // prevent too deep recursion
    const hasChildren = v.children && v.children.length > 0;
    const isExpandable = hasChildren && depth < maxDepth;
    
    // Determine display value
    let valueDisplay = '';
    if (v.value && v.value !== '') {
        valueDisplay = escapeHtml(v.value);
    } else if (v.type && v.type.startsWith('[]')) {
        const len = v.len || 0;
        const cap = v.cap || 0;
        valueDisplay = `(${len}/${cap})`;
    } else if (v.type && v.type.startsWith('map[')) {
        const len = v.len || 0;
        valueDisplay = `(${len} entries)`;
    } else if (v.type && v.type.startsWith('struct')) {
        valueDisplay = `{…}`;
    } else {
        valueDisplay = '?';
    }

    // Build header
    const expandIcon = isExpandable 
        ? `<span class="expand-icon" data-expanded="false">▶</span>` 
        : `<span style="width:16px;display:inline-block;"></span>`;
    
    const header = `
        <div class="var-header" data-var-id="${v.addr || Math.random()}">
            ${expandIcon}
            <span class="var-name">${escapeHtml(v.name || '')}</span>
            <span class="var-value">${valueDisplay}</span>
            <span class="var-type">${escapeHtml(v.type || '')}</span>
        </div>
    `;

    // Render children if expandable
    let childrenHtml = '';
    if (isExpandable) {
        childrenHtml = '<div class="var-children" style="display:none;">';
        childrenHtml += v.children.map(child => renderVariable(child, depth + 1)).join('');
        childrenHtml += '</div>';
    }

    return `<div class="var-item">${header}${childrenHtml}</div>`;
}

function refreshLocals() {
    if (!locals || !locals.length) {
        varsPanel.innerHTML = '<span style="color: #858585;">None</span>';
        varCount.textContent = '';
        return;
    }

    varCount.textContent = `(${locals.length})`;
    varsPanel.innerHTML = `<div class="var-tree">${locals.map(v => renderVariable(v)).join('')}</div>`;

    // Attach click handlers for expand/collapse
    document.querySelectorAll('.var-header').forEach(header => {
        header.addEventListener('click', (e) => {
            // Don't toggle if clicking on the expand icon specifically (handled separately)
            const icon = header.querySelector('.expand-icon');
            if (icon && e.target === icon) {
                e.stopPropagation();
            }
            const childrenDiv = header.parentElement.querySelector('.var-children');
            const iconSpan = header.querySelector('.expand-icon');
            if (childrenDiv) {
                const isHidden = childrenDiv.style.display === 'none';
                childrenDiv.style.display = isHidden ? 'block' : 'none';
                if (iconSpan) {
                    iconSpan.classList.toggle('expanded', isHidden);
                }
            }
        });
    });
}

        function refreshStack() {
            if (!stack.length) {
                stackPanel.innerHTML = '<span style="color: #858585;">Empty</span>';
                return;
            }

            stackPanel.innerHTML = stack
                .filter(f => !f.Err && !f.Bottom) // skip invalid/bottom frames
                .map((f, idx) => {
                    const selected = idx === currentFrame ? 'selected' : '';
                    // Use lowercase property names as per JSON tags
                    const funcName = f.function?.name || '??';
                    const file = f.file || '';
                    const line = f.line || 0;
                    const location = file && line ? `${file}:${line}` : 'unknown location';
                    return `<div class="stack-item stack-frame ${selected}" data-frame="${idx}">
                        ${escapeHtml(funcName)} at ${escapeHtml(location)}
                    </div>`;
                }).join('');

            // Reattach click handlers
            document.querySelectorAll('.stack-frame').forEach(el => {
                el.addEventListener('click', () => {
                    const frameIdx = parseInt(el.dataset.frame);
                    setCurrentFrame(frameIdx);
                });
            });
        }

        function refreshGoroutines() {
            if (!goroutines.length) {
                goroutinesPanel.innerHTML = '<span style="color: #858585;">None</span>';
                goroutineCount.textContent = '';
                return;
            }
            goroutineCount.textContent = `(${goroutines.length})`;
            goroutinesPanel.innerHTML = goroutines.map(g => `
                <div class="goroutine-item" data-gid="${g.ID}">
                    Goroutine ${g.id} - ${g.status} ${g.currentLoc.file}:${g.currentLoc.line}
                </div>
            `).join('');
        }

        function refreshBreakpoints() {
            if (!breakpoints || !breakpoints.length) {
                breakpointsPanel.innerHTML = '<span style="color: #858585;">None</span>';
                return;
            }
            breakpointsPanel.innerHTML = breakpoints.map(bp => {
                // Use lowercase property names
                const id = bp.id;
                const file = bp.file || '';
                const line = bp.line || 0;
                const func = bp.functionName || '';
                
                // Build display string
                let location = '';
                if (file && line > 0) {
                    const shortFile = file.split('/').pop();
                    location = `${shortFile}:${line}`;
                } else if (func) {
                    location = func;
                } else {
                    location = 'unknown';
                }
                
                // Add special marker for built-in breakpoints (negative IDs)
                const builtin = id < 0 ? ' (built-in)' : '';
                
                return `<div class="bp-item">
                    #${id} ${location}${builtin}
                    ${id > 0 ? `<button onclick="removeBreakpoint(${id})" style="float:right; padding:2px 6px;">✕</button>` : ''}
                </div>`;
            }).join('');
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // ---------- Breakpoint Management ----------
        function toggleBreakpoint(line) {
            const existing = breakpoints.find(bp => bp.line === line && bp.file === currentSourceFile);
            if (existing) {
                sendCommand('clear', {id: existing.id});
            } else {
                sendCommand('break', {file: currentSourceFile, line: line});
            }
        }

        window.removeBreakpoint = function(id) {
            sendCommand('clear', {id: id});
        };

        // ---------- WebSocket Communication ----------
        function connectWebSocket(sid) {
            if (ws && ws.readyState === WebSocket.OPEN) {
                ws.close();
            }
            const wsUrl = `${window.location.protocol === 'https:' ? 'wss:' : 'ws:'}//${window.location.host}/ws/${sid}`;
            ws = new WebSocket(wsUrl);
            ws.onopen = () => {
                setStatus(true, 'Connected');
                console.log('WebSocket connected');
                compileBtn.disabled = true;
                stopBtn.disabled = false;
                editor.setOption('readOnly', true); // lock editor
                // fetch initial state
                sendCommand('state');
                sendCommand('breakpoints');
                sendCommand('goroutines');
                sendCommand('stack');
                sendCommand('locals');
            };
            ws.onclose = (ev) => {
                setStatus(false, 'Disconnected');
                console.log(`WebSocket closed: ${ev.reason || 'normal'}`);
                resetUI();
            };
            ws.onerror = (err) => {
                console.log('WebSocket error');
                console.error(err);
            };
            ws.onmessage = (event) => {
                try {
                    const msg = JSON.parse(event.data);
                    handleResponse(msg);
                } catch (e) {
                    console.log('Invalid message received');
                }
            };
        }

        function handleResponse(msg) {
            if (msg.error) {
                // deduplicate the "exited" message
                if (msg.error.includes("exited with status")) {
                    if (!exitMessageShown) {
                        log(msg.error, 'error');
                        exitMessageShown = true;
                    }
                    // Still mark the program as exited
                    programExited = true;
                    updateUIAfterState();
                    return;
                }
                // other errors are displayed normally
                log(msg.error, 'error');
                return;
            }

            exitMessageShown = false;

            switch (msg.type) {
                case 'state':
                    debugState = msg.data;
                    updateUIAfterState();
                    break;
                case 'locals':
                    locals = msg.data || [];
                    refreshLocals();
                    break;
                case 'stack':
                    stack = msg.data || [];
                    refreshStack();
                    break;
                case 'goroutines':
                    goroutines = msg.data || [];
                    refreshGoroutines();
                    break;
                case 'breakpoints':
                    breakpoints = msg.data || [];
                    refreshBreakpoints();
                    updateBreakpointGutter();
                    break;
                case 'break':
                case 'clear':
                    // Refresh breakpoints list
                    sendCommand('breakpoints');
                    break;
                case 'continue':
                case 'next':
                case 'step':
                case 'stepout':
                case 'restart':
                    sendCommand('state');
                    sendCommand('locals');
                    sendCommand('stack');
                    break;
                default:
                    log(msg.data, 'info');
            }
        }

        function updateBreakpointGutter() {
            editor.clearGutter('breakpoints');
            breakpoints.forEach(bp => {
                // Only show user breakpoints (positive IDs) in our source file
                if (bp.id > 0 && bp.file === currentSourceFile && bp.line) {
                    const marker = document.createElement('div');
                    marker.className = 'breakpoint-gutter';
                    marker.textContent = '●';
                    editor.setGutterMarker(bp.line - 1, 'breakpoints', marker);
                }
            });
        }

        function sendCommand(cmd, args = {}) {
            if (!ws || ws.readyState !== WebSocket.OPEN) {
                log('Not connected to debug session', 'error');
                return;
            }
            ws.send(JSON.stringify({command: cmd, args: args}));
        }

        function resetUI() {
            sessionId = null;
            debugState = null;
            locals = [];
            stack = [];
            goroutines = [];
            breakpoints = [];
            programExited = false;
            compileBtn.disabled = false;
            enableDebugControls(false);
            varsPanel.innerHTML = 'None';
            stackPanel.innerHTML = 'Empty';
            goroutinesPanel.innerHTML = 'None';
            breakpointsPanel.innerHTML = 'None';
            varCount.textContent = '';
            goroutineCount.textContent = '';
            positionInfo.textContent = '';
            editor.clearGutter('breakpoints');
            editor.setOption('readOnly', false); // unlock editor
            if (currentLineMarker !== null) {
                editor.removeLineClass(currentLineMarker, 'background');
                currentLineMarker = null;
            }
        }

        function setCurrentFrame(idx) {
            currentFrame = idx;
            refreshStack();
            // Fetch locals for that frame (by evaluating with frame)
            // Not directly supported by current command set; you'd need to extend backend.
        }

        // ---------- Compile & Start Session ----------
        async function compile() {
            // clear output panel
            outputDiv.innerHTML = '';
            exitMessageShown = false;

            const code = editor.getValue();
            compileBtn.disabled = true;
            log('compiling...', '');
            try {
                const resp = await fetch(`${API_BASE}/build`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({code: code})
                });
                const data = await resp.json();
                if (!resp.ok) {
                    throw new Error(data.error || 'Compilation failed');
                }
                if (data.formatted && data.formatted !== code) {
                    editor.setValue(data.formatted);
                }
                sessionId = data.session_id;
                log(`debug started`, '');
                connectWebSocket(sessionId);
            } catch (err) {
                log(`compile error: ${err.message}`, 'error');
                compileBtn.disabled = false;
            }
        }

        function disconnect() {
            if (ws) ws.close();
            resetUI();
            setStatus(false, 'Disconnected');
        }

        function restart() {
            sendCommand('restart');
        }

        // ---------- Event Listeners ----------
        compileBtn.addEventListener('click', compile);
        continueBtn.addEventListener('click', () => sendCommand('continue'));
        nextBtn.addEventListener('click', () => sendCommand('next'));
        stepBtn.addEventListener('click', () => sendCommand('step'));
        stepOutBtn.addEventListener('click', () => sendCommand('stepout'));
        restartBtn.addEventListener('click', restart);
        stopBtn.addEventListener('click', disconnect);

        // Section toggling
        document.querySelectorAll('.panel-header').forEach(header => {
            header.addEventListener('click', () => {
                const content = header.nextElementSibling;
                content.style.display = content.style.display === 'none' ? 'block' : 'none';
                header.querySelector('span').textContent = 
                    (content.style.display === 'none' ? '▶' : '▼') + 
                    header.querySelector('span').textContent.slice(1);
            });
        });

        // Expose for inline handlers
        window.compile = compile;
        window.sendCommand = sendCommand;
        window.disconnect = disconnect;
        window.restart = restart;
    })();
</script>
</body>
