			code:    string(make([]byte, cfg.MaxSourceSize+1)),
			wantErr: true,
			errMsg:  "source code too large",
		},
		{
			name:    "forbidden import syscall",
			code:    `package main; import "syscall"; func main() {}`,
			wantErr: true,
			errMsg:  "not allowed",
		},
